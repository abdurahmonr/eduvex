# ==============================================================================
# Education Center ERP + CRM - Environment Variables Template
# ==============================================================================
# Copy this file to .env in each application or root for local development.
# IMPORTANT: Never commit actual secrets or the Supabase service role key here.
# ==============================================================================

# Supabase Public API Configuration (Used by all portals via @education-erp/shared-auth)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key

# Environment & Platform Settings
VITE_APP_ENV=development
VITE_BASE_DOMAIN=example.uz

# Portal Port Mapping (Local Development)
VITE_DIRECTOR_PORT=3001
VITE_ADMIN_PORT=3002
VITE_TEACHER_PORT=3003
VITE_STUDENT_PORT=3004
VITE_PARENT_PORT=3005

# Portal URLs (Used for cross-portal navigation in dev/prod)
VITE_DIRECTOR_URL=http://localhost:3001
VITE_ADMIN_URL=http://localhost:3002
VITE_TEACHER_URL=http://localhost:3003
VITE_STUDENT_URL=http://localhost:3004
VITE_PARENT_URL=http://localhost:3005
